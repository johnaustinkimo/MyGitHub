# /etc/systemd/system/ts4500Toscalari3-websocketd.service
[Unit]
Description=TS4500 to Scalar i3 Tape Operations WebSocket Daemon
Wants=network-online.target
After=network-online.target remote-fs.target
ConditionFileIsExecutable=/ws/ts4500Toscalari3/websocketd
ConditionFileIsExecutable=/ws/ts4500Toscalari3/wsmanager_ts4500Toscalari3_v1.1.sh
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/ws/ts4500Toscalari3
UMask=0077
Environment="PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="HOME=/root"
Environment="USER=root"
Environment="LOGNAME=root"
Environment="SHELL=/bin/bash"
Environment="LANG=C.UTF-8"
Environment="LC_ALL=C.UTF-8"
ExecStartPre=/usr/bin/test -x /ws/ts4500Toscalari3/websocketd
ExecStartPre=/usr/bin/test -x /ws/ts4500Toscalari3/wsmanager_ts4500Toscalari3_v1.1.sh
ExecStartPre=/usr/bin/test -x /ws/ts4500Toscalari3/logGP_it.sh
ExecStartPre=/usr/bin/test -x /ws/ts4500Toscalari3/ts4500_ops_v1.5.sh
ExecStartPre=/usr/bin/test -x /ws/ts4500Toscalari3/scalari3_tape_write_v1.3.sh
ExecStartPre=/usr/bin/bash -n /ws/ts4500Toscalari3/wsmanager_ts4500Toscalari3_v1.1.sh
ExecStart=/ws/ts4500Toscalari3/websocketd \
    --address=192.168.169.101 \
    --port=1234 \
    --reverselookup=false \
    --loglevel=access \
    --maxforks=20 \
    --closems=5000 \
    --passenv=PATH,HOME,USER,LOGNAME,SHELL,LANG,LC_ALL \
    /ws/ts4500Toscalari3/wsmanager_ts4500Toscalari3_v1.1.sh
Restart=on-failure
RestartSec=3s
TimeoutStartSec=15s
TimeoutStopSec=30s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
LimitNOFILE=65536
TasksMax=256
CPUAccounting=yes
MemoryAccounting=yes
TasksAccounting=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
LockPersonality=yes
SystemCallArchitectures=native
StandardOutput=journal
StandardError=journal
SyslogIdentifier=ts4500Toscalari3-websocketd

[Install]
WantedBy=multi-user.target
