# HiCloud Secure Storage Recovery v1.3.4 example configuration

S3S_BIN="/usr/local/bin/secure-storage-desktop-shell"
ACCESS_KEY="CHANGE_ME"
SECRET_KEY="CHANGE_ME"

RECOVERY_DIR="/data_bk/HiCloudSecretS3"
TEMP_WORKSPACE="/data_bk/HiCloudSecretS3_tmp"
ENCRYPTION_KEY_FILE="/ws/linux/usr/bin/20260709.key"

LOG_DIR="/var/log/hicloud-recovery"
STATE_DIR="/var/lib/hicloud-recovery"

LIST_RETRIES=3
LIST_RETRY_DELAY_SEC=10
RECOVERY_TIMEOUT_SEC=43200
MONITOR_INTERVAL_SEC=30
MONITOR_HEARTBEAT_SEC=300
STABLE_INTERVAL_SEC=5
STABLE_CHECK_COUNT=3
MIN_FREE_GB=150
VERIFY_TAR=no
CALCULATE_SHA256=no

# ============================================================
# Post-recovery restore verification
# ============================================================
POST_VERIFY=yes

# Modes:
#   smallest = verify the smallest safe *.o3.signed member
#   random   = randomly choose one safe *.o3.signed member
#   all      = verify every safe *.o3.signed member sequentially
#
# Recommended daily production default:
#   POST_VERIFY_MODE=smallest
#
# Use "all" for periodic full restore-chain verification because it may
# require significant time and temporary disk space for large members.
POST_VERIFY_MODE=smallest

# Applies to all mode only:
#   yes = stop immediately at first failed member (recommended)
#   no  = continue checking remaining members and report overall failure
POST_VERIFY_ALL_STOP_ON_FAILURE=yes

VERIFY_WORK_ROOT="/data_bk/HiCloudSecretS3_tmp/postverify"

# Production recommendation: no
# yes is useful during troubleshooting but may retain decrypted intermediate files.
KEEP_VERIFY_WORK_ON_FAILURE=no

GPG_BIN="/usr/bin/gpg"
GPG_HOMEDIR="/root/.gnupg"
GPG_PASSPHRASE_FILE="/root/.config/hicloud-recovery/gpg.passphrase"

# Pin both fingerprints observed from the trusted backup signing key.
GPG_EXPECTED_SIGNING_FPR="A8F63A14346423BF832F7DBD23C22F2BD76D7DE1"
GPG_EXPECTED_PRIMARY_FPR="DCFC1E1BC8ECF64BA9D5EC5BA094333141C3DE57"

ZSTD_BIN="/usr/bin/zstd"

# ============================================================
# Actual inner restore extraction verification (v1.3.1)
# ============================================================

# yes = after zstd/tar listing succeeds, actually extract the inner TAR
#       into a private temporary directory and verify restored files.
# no  = stop at zstd integrity + inner TAR listing checks (v1.3.0 behavior).
POST_VERIFY_EXTRACT_INNER=yes

# yes = extracted payload must contain at least one regular file.
# Recommended: yes.
POST_VERIFY_REQUIRE_REGULAR_FILE=yes

# yes = every extracted regular file must be non-empty.
# Recommended default: no, because a legitimate backup may contain 0-byte files.
POST_VERIFY_REQUIRE_NONEMPTY=no

# Production recommendation: no.
# If yes, successful extracted sample output is moved under:
#   ${VERIFY_WORK_ROOT}/kept/<archive>/<member>.restore.<timestamp>
# Decrypted intermediate GPG layers are still removed.
KEEP_VERIFY_RESTORE_OUTPUT=no

# ============================================================
# Large-file progress / timeout / all-mode checkpoint (v1.3.2)
# ============================================================

# How often to emit progress for long-running large-file stages.
POST_VERIFY_PROGRESS_INTERVAL_SEC=30

# Internal process polling interval. 2 seconds is a good balance.
POST_VERIFY_PROGRESS_POLL_SEC=2

# Reserved heartbeat interval for slow/no-output stages.
POST_VERIFY_PROGRESS_HEARTBEAT_SEC=300

# Hard timeout for one selected *.o3.signed member across all stages.
# 14400 = 4 hours.
POST_VERIFY_MEMBER_TIMEOUT_SEC=14400

# Hard timeout for each GPG signature/decrypt stage.
# The effective timeout is the smaller of this value and the remaining
# POST_VERIFY_MEMBER_TIMEOUT_SEC.
POST_VERIFY_GPG_LAYER_TIMEOUT_SEC=7200

# Hard timeout for each zstd / inner TAR scanning stage.
POST_VERIFY_ZSTD_TIMEOUT_SEC=7200

# Hard timeout for outer-member extraction and actual inner restore extraction.
POST_VERIFY_EXTRACT_TIMEOUT_SEC=7200

# all mode only:
# yes = persist each successfully verified member and resume after interruption.
POST_VERIFY_CHECKPOINT=yes

# Root-only checkpoint directory. A checkpoint is bound to:
#   archive full path + archive size + selected-member manifest SHA256
#   + verify mode/policy + pinned GPG fingerprints.
POST_VERIFY_CHECKPOINT_DIR="/var/lib/hicloud-recovery/postverify-checkpoints"

# ============================================================
# Adaptive sub-second polling / millisecond timing (v1.3.3)
# ============================================================

# yes = use adaptive polling:
#       * short stages: fast sub-second polling
#       * long stages : slower polling to reduce overhead
# no  = fall back to POST_VERIFY_PROGRESS_POLL_SEC from v1.3.2
POST_VERIFY_ADAPTIVE_POLL=yes

# Poll every 200 ms during the first POST_VERIFY_FAST_POLL_WINDOW_SEC.
# This removes the artificial 2-second floor seen with small verification files.
POST_VERIFY_FAST_POLL_MS=200

# Keep fast polling for the first 10 seconds of each stage.
POST_VERIFY_FAST_POLL_WINDOW_SEC=10

# After the fast window, poll once per second.
# Progress logging still remains controlled separately by
# POST_VERIFY_PROGRESS_INTERVAL_SEC (default 30 seconds).
POST_VERIFY_SLOW_POLL_MS=1000



# ============================================================
# Inner original-file logging (v1.3.4)
# ============================================================

# yes = write the original inner TAR entries to the recovery log.
# This is log-only observability and does not change checkpoint compatibility.
POST_VERIFY_LOG_INNER_FILES=yes

# names   = only original path/file names (equivalent to tar -tf)
# verbose = permissions/owner/size/time/name (equivalent to tar -tvf)
# Recommended: verbose
POST_VERIFY_LOG_INNER_FILES_FORMAT=verbose

# Maximum entries logged per verified *.o3.signed member.
# If an inner TAR contains more entries, only the first N are logged and
# a truncation summary is written. Increase when full listing is desired.
POST_VERIFY_LOG_INNER_FILES_MAX=100
